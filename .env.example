# Application
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/arrayan_hris_dev?schema=public

# Security (JWT & Cookies) — WAJIB, minimal 32 karakter. Server menolak start jika kosong.
# Generate untuk production: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_arrayan_hris_dev_2026
COOKIE_SECRET=super_secret_cookie_key_arrayan_hris_dev_2026

# Set true jika API berjalan di belakang reverse proxy (nginx) agar IP klien terbaca benar
TRUST_PROXY=false


# Integration test (npm run test:int) — DB terpisah, nama wajib mengandung "test".
# Dibuat otomatis oleh `prisma migrate deploy` bila belum ada.
TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/arrayan_hris_test?schema=public

# Onboarding karyawan — link aktivasi = APP_BASE_URL/activate?token=...
APP_BASE_URL=http://localhost:5173
# Driver pengiriman undangan: saat ini hanya "log" (link dicetak di log & response, non-production saja).
# smtp / resend / whatsapp menyusul saat VPS & provider siap.
INVITATION_DRIVER=log
