# Salin ke .env.production di VPS (JANGAN di-commit). Generate secret: openssl rand -hex 32
# Gunakan karakter alfanumerik untuk POSTGRES_PASSWORD (dipakai di dalam DATABASE_URL).

# --- Database ---
POSTGRES_USER=arrayan
POSTGRES_PASSWORD=GANTI_DENGAN_openssl_rand_hex_32
POSTGRES_DB=arrayan_hris

# --- Keamanan (wajib berbeda, >= 32 karakter) ---
JWT_SECRET=GANTI_DENGAN_openssl_rand_hex_32
COOKIE_SECRET=GANTI_DENGAN_openssl_rand_hex_32_yang_lain

# --- URL (wajib https) ---
# Origin frontend; beberapa origin dipisah koma
CORS_ORIGIN=https://hris.domain-klien.co.id
# URL frontend untuk link aktivasi / reset password
APP_BASE_URL=https://hris.domain-klien.co.id

# --- Lainnya ---
TRUST_PROXY=true
INVITATION_DRIVER=log
LOG_LEVEL=info
DOCS_ENABLED=false
# Port API di localhost VPS (reverse proxy mengarah ke sini)
API_PORT=4000

# --- Seed awal (sekali saja, lihat docs/DEPLOYMENT.md) ---
SUPER_ADMIN_EMAIL=hr@domain-klien.co.id
# >= 12 karakter, huruf besar, huruf kecil, angka, simbol. Hapus dari file setelah seed awal.
SUPER_ADMIN_PASSWORD=
