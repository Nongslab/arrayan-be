datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. Roles & Permissions (Fleksibel Data-Driven, Bukan Enum Kaku)
// -------------------------------------------------------------
model Role {
  id          String   @id @default(uuid())
  code        String   @unique // 'SUPER_ADMIN', 'MANAGEMENT', 'SR_MANAGER', 'MANAGER', 'SUPERVISOR', 'STAFF'
  name        String // 'Super Admin / HR GA', 'Management', etc.
  description String?
  permissions Json     @default("[]") // Array of string permissions
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// -------------------------------------------------------------
// 2. User Accounts (Khusus Autentikasi & Keamanan)
// -------------------------------------------------------------
model User {
  id             String         @id @default(uuid())
  email          String         @unique
  /// Null selama akun belum diaktivasi (PENDING_ACTIVATION).
  passwordHash   String?        @map("password_hash")
  roleId         String         @map("role_id")
  role           Role           @relation(fields: [roleId], references: [id])
  employee       Employee?
  refreshTokens  RefreshToken[]
  accountTokens  AccountToken[]
  auditLogs      AuditLog[]
  status         UserStatus     @default(ACTIVE)
  /// Naik setiap akun dinonaktifkan / password diganti / di-reset → semua access token lama tidak berlaku.
  sessionVersion Int            @default(0) @map("session_version")
  lastLoginAt    DateTime?      @map("last_login_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

/// Token sekali pakai (aktivasi akun, reset password). Hanya hash SHA-256 yang disimpan.
model AccountToken {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("account_tokens")
}

enum TokenPurpose {
  ACTIVATION
  PASSWORD_RESET
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// -------------------------------------------------------------
// 3. Employee Profile & Hierarchy (Tree Branch)
// -------------------------------------------------------------
model Employee {
  id               String         @id @default(uuid())
  userId           String?        @unique @map("user_id")
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  nik              String         @unique
  fullName         String         @map("full_name")
  employmentType   EmploymentType @default(PROBATION) @map("employment_type")
  joinDate         DateTime       @default(now()) @map("join_date")
  /// Akhir masa probation (default joinDate + 6 bulan, PRD Module 1). Null bila bukan PROBATION sejak awal.
  probationEndDate DateTime?      @map("probation_end_date") @db.Date
  /// INACTIVE = karyawan keluar. Data tidak dihapus agar bisa diaktifkan kembali.
  status           EmployeeStatus @default(ACTIVE)
  exitDate         DateTime?      @map("exit_date") @db.Date

  // Data pribadi (US-2.7) — hanya terlihat oleh SUPER_ADMIN & karyawan ybs.
  birthDate     DateTime? @map("birth_date") @db.Date
  gender        Gender?
  phone         String?
  personalEmail String?   @map("personal_email")
  address       String?

  // Relasi ke Master Data (AGENTS.md §1 — tidak ada free-text untuk entitas inti)
  jobTitleId       String          @map("job_title_id")
  jobTitle         JobTitle        @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  departmentId     String?         @map("department_id")
  department       Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  officeLocationId String?         @map("office_location_id") // Lokasi absensi default
  officeLocation   OfficeLocation? @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  workShiftId      String?         @map("work_shift_id") // Shift kerja default
  workShift        WorkShift?      @relation(fields: [workShiftId], references: [id], onDelete: Restrict)

  // Tree Branch Hierarchy: Self-referencing Foreign Key
  managerId               String?                  @map("manager_id")
  manager                 Employee?                @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates            Employee[]               @relation("EmployeeHierarchy")
  leaveRequests           LeaveRequest[]
  attendanceLogs          AttendanceLog[]
  trainingParticipations  TrainingParticipant[]
  leaveBalanceAdjustments LeaveBalanceAdjustment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([jobTitleId])
  @@index([departmentId])
  @@index([officeLocationId])
  @@index([workShiftId])
  @@index([status])
  @@map("employees")
}

enum EmploymentType {
  PROBATION
  KARTAP
  PKL
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

// =============================================================
// 4. MASTER DATA
// Konvensi: id (uuid), code (UPPER_SNAKE unik), name, isActive,
// createdAt/updatedAt. Nonaktifkan via isActive — jangan hapus row
// yang sudah direferensikan (FK menggunakan onDelete: Restrict).
// =============================================================

/// Level hierarki jabatan (Tree Branch PRD) — terpisah dari Role (hak akses RBAC).
enum HierarchyLevel {
  MANAGEMENT
  SR_MANAGER
  MANAGER
  SUPERVISOR
  STAFF
}

/// Departemen / Divisi berjenjang (Divisi → Sub-divisi) via parentId.
model Department {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  description  String?
  parentId     String?       @map("parent_id")
  parent       Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Department[]  @relation("DepartmentHierarchy")
  employees    Employee[]
  kpiTemplates KpiTemplate[]
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("departments")
}

/// Jabatan beserta level hierarkinya.
model JobTitle {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  level        HierarchyLevel @default(STAFF)
  description  String?
  employees    Employee[]
  kpiTemplates KpiTemplate[]
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("job_titles")
}

/// Lokasi kantor untuk Geofencing (radius GPS) & Wi-Fi Location Lock.
model OfficeLocation {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  address      String?
  latitude     Decimal    @db.Decimal(9, 6)
  longitude    Decimal    @db.Decimal(9, 6)
  radiusMeters Int        @default(100) @map("radius_meters")
  wifiSsids    String[]   @default([]) @map("wifi_ssids")
  wifiBssids   String[]   @default([]) @map("wifi_bssids")
  timezone     String     @default("Asia/Jakarta")
  employees    Employee[]
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("office_locations")
}

/// Shift / jam kerja. Waktu format "HH:mm" (zona waktu lokasi kantor).
model WorkShift {
  id                   String     @id @default(uuid())
  code                 String     @unique
  name                 String
  startTime            String     @map("start_time")
  endTime              String     @map("end_time")
  breakMinutes         Int        @default(60) @map("break_minutes")
  lateToleranceMinutes Int        @default(15) @map("late_tolerance_minutes")
  /// Hari kerja ISO-8601: 1 = Senin … 7 = Minggu
  workDays             Int[]      @default([1, 2, 3, 4, 5]) @map("work_days")
  isOvernight          Boolean    @default(false) @map("is_overnight")
  employees            Employee[]
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  @@map("work_shifts")
}

enum LeaveCategory {
  ANNUAL
  SICK
  PERMISSION
  MATERNITY
  SPECIAL
  UNPAID
}

/// Jenis cuti / izin. category dipakai untuk logika bisnis (mis. widget "Yang Sakit Hari Ini").
model LeaveType {
  id                 String                   @id @default(uuid())
  code               String                   @unique
  name               String
  category           LeaveCategory
  /// Kuota default per tahun (hari). 0 = tidak dibatasi kuota.
  defaultQuota       Int                      @default(0) @map("default_quota")
  isPaid             Boolean                  @default(true) @map("is_paid")
  requiresAttachment Boolean                  @default(false) @map("requires_attachment")
  deductsAnnualLeave Boolean                  @default(false) @map("deducts_annual_leave")
  leaveRequests      LeaveRequest[]
  balanceAdjustments LeaveBalanceAdjustment[]
  isActive           Boolean                  @default(true) @map("is_active")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@map("leave_types")
}

enum HolidayKind {
  NATIONAL
  COLLECTIVE_LEAVE
  COMPANY
}

/// Hari libur nasional, cuti bersama (memotong cuti tahunan), dan libur perusahaan.
model Holiday {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  date      DateTime    @db.Date
  kind      HolidayKind
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([date])
  @@map("holidays")
}

/// Kategori pelatihan (Modul 6).
model TrainingCategory {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  trainings   Training[]
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("training_categories")
}

enum KpiPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum KpiIndicatorType {
  QUANTITATIVE
  QUALITATIVE
}

/// Template KPI — berlaku per jabatan dan/atau departemen (keduanya opsional = umum).
model KpiTemplate {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  description  String?
  period       KpiPeriod      @default(QUARTERLY)
  jobTitleId   String?        @map("job_title_id")
  jobTitle     JobTitle?      @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  departmentId String?        @map("department_id")
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  indicators   KpiIndicator[]
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([jobTitleId])
  @@index([departmentId])
  @@map("kpi_templates")
}

/// Indikator penilaian dalam template KPI. Total weight per template = 100 (divalidasi di API).
model KpiIndicator {
  id          String           @id @default(uuid())
  templateId  String           @map("template_id")
  template    KpiTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        KpiIndicatorType
  weight      Decimal          @db.Decimal(5, 2)
  /// Target angka (khusus QUANTITATIVE)
  target      Decimal?         @db.Decimal(14, 2)
  unit        String?
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([templateId])
  @@map("kpi_indicators")
}

// =============================================================
// 5. AUDIT LOG
// Jejak aksi admin & keamanan. Ditulis dalam transaksi yang sama dengan aksinya.
// Tidak pernah memuat password / token / hash.
// =============================================================
model AuditLog {
  id          String   @id @default(uuid())
  /// Nomor urut monoton — pengurut stabil untuk entri dalam transaksi yang sama (created_at bisa identik)
  seq         Int      @unique @default(autoincrement())
  /// Pelaku (null untuk aksi sistem / publik, mis. login terkunci)
  actorUserId String?  @map("actor_user_id")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Snapshot email pelaku saat aksi terjadi
  actorEmail  String?  @map("actor_email")
  /// Kode aksi, mis. "employee.create", "master.department.update", "auth.password_reset"
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  /// Detail perubahan: { after } untuk create, { field: { from, to } } untuk update, atau info aksi
  changes     Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([action])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================
// 6. CUTI & IZIN (Fase 5)
// =============================================================
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Pengajuan cuti / izin / sakit. Approval berjenjang (US-5.3) menyusul.
model LeaveRequest {
  id           String             @id @default(uuid())
  employeeId   String             @map("employee_id")
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId  String             @map("leave_type_id")
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  /// Jumlah hari yang dihitung (hari kerja, atau hari kalender untuk cuti melahirkan)
  days         Int
  /// Pembagian hari per tahun kalender saat diajukan, mis. {"2026": 4, "2027": 2}
  daysByYear   Json               @map("days_by_year")
  reason       String?
  status       LeaveRequestStatus @default(PENDING)
  cancelledAt  DateTime?          @map("cancelled_at")
  cancelReason String?            @map("cancel_reason")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([employeeId, startDate])
  @@index([status, startDate])
  @@map("leave_requests")
}

/// Penyesuaian saldo cuti oleh HR (+/- hari) untuk satu tahun.
model LeaveBalanceAdjustment {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId String    @map("leave_type_id")
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  year        Int
  days        Int
  reason      String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([employeeId, leaveTypeId, year])
  @@map("leave_balance_adjustments")
}

// =============================================================
// 7. KEHADIRAN (Fase 3)
// Hanya log mentah yang disimpan; status harian dihitung saat dibaca oleh
// engine (src/modules/attendance/attendance.engine.ts) dari shift, hari libur, & cuti.
// =============================================================
enum AttendanceSource {
  APP
  FINGERPRINT
  MANUAL
}

model AttendanceLog {
  id         String           @id @default(uuid())
  employeeId String           @map("employee_id")
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// Waktu kejadian (instant, timestamptz)
  occurredAt DateTime         @map("occurred_at") @db.Timestamptz(3)
  source     AttendanceSource
  latitude   Decimal?         @db.Decimal(9, 6)
  longitude  Decimal?         @db.Decimal(9, 6)
  ip         String?
  /// Kode perangkat fingerprint (US-3.3) bila sumbernya FINGERPRINT
  deviceCode String?          @map("device_code")
  /// Alasan koreksi (MANUAL, US-3.5)
  note       String?
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([employeeId, occurredAt])
  @@index([occurredAt])
  @@map("attendance_logs")
}

// =============================================================
// 8. TRAINING (PRD Module 5 & 6)
// =============================================================
enum TrainingStatus {
  SCHEDULED
  CANCELLED
}

model Training {
  id           String                @id @default(uuid())
  title        String
  description  String?
  categoryId   String                @map("category_id")
  category     TrainingCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Penyelenggara (internal / vendor eksternal)
  organizer    String?
  location     String?
  startAt      DateTime              @map("start_at") @db.Timestamptz(3)
  endAt        DateTime              @map("end_at") @db.Timestamptz(3)
  status       TrainingStatus        @default(SCHEDULED)
  participants TrainingParticipant[]
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([startAt])
  @@index([categoryId])
  @@map("trainings")
}

/// Peserta training + remarks/feedback (diisi peserta setelah training selesai).
model TrainingParticipant {
  id         String    @id @default(uuid())
  trainingId String    @map("training_id")
  training   Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employeeId String    @map("employee_id")
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// Ditandai HR; null = belum dicatat
  attended   Boolean?
  remarks    String?
  /// Penilaian peserta 1–5
  rating     Int?
  remarkedAt DateTime? @map("remarked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([trainingId, employeeId])
  @@index([employeeId])
  @@map("training_participants")
}
